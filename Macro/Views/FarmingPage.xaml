<Page x:Class="Macro.Views.FarmingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Macro.Views"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="FarmingPage">
    
    <Grid>
        <StackPanel Margin="10" VerticalAlignment="Top">
            <TextBlock Text="Farming" Foreground="White" FontSize="18" Margin="0,0,0,10" />
            <WrapPanel Margin="0,0,0,10">
                <Button x:Name="BtnStart" Content="Start" Click="BtnStart_Click" Width="80" Margin="0,0,10,0" />
                <Button x:Name="BtnStop" Content="Stop" Click="BtnStop_Click" Width="80" />
                <Button x:Name="BtnMousePercent" Content="MousePercent" Click="BtnMousePercent_Click" Width="120" Margin="10,0,0,0" />
                <Button x:Name="BtnDoArena" Content="DoArena" Click="BtnDoArena_Click" Width="100" Margin="10,0,0,0" />
            </WrapPanel>
            <Border BorderBrush="Gray" BorderThickness="1" Width="800" Height="450">
                <Image x:Name="ScreenshotImage" Stretch="Uniform" />
            </Border>
        </StackPanel>
    </Grid>
</Page>
