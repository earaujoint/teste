<Page x:Class="Macro.Views.DailyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Macro.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DailyPage">

    <Grid Background="#1a1a19">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="15">
            <TextBlock Text="Escolher mapa"
               Foreground="#f0efec"
               FontSize="18"
               FontWeight="SemiBold"/>

            <TextBlock Text="Selecione o mapa e o item alvo."
               Foreground="#c3c2b7"
               FontSize="14"
               FontWeight="SemiBold"
               Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="15, 0, 0, 0">
            <TextBlock Text="Mapas"
               Foreground="#a8a59f"
               FontSize="14"
               FontWeight="SemiBold"
               Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</Page>
 