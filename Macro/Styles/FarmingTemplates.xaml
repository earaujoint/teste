<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="RaidTemplate">
        <Border Style="{StaticResource SelectableCard}" Width="300" Margin="0,0,12,12">
            <StackPanel>
                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding IsAvailable}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" MinHeight="40" />
                <Border Background="#242322" Height="100" CornerRadius="4" Margin="0,0,0,18">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="⚔" FontSize="34" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="MIR4 · RAID" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel IsEnabled="{Binding IsAvailable}">
                    <TextBlock Text="Quantidade de vezes" Margin="0,0,0,7" />
                    <TextBox Text="{Binding RepeatCountText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" IsEnabled="{Binding IsEnabled}" AutomationProperties.Name="Quantidade de repetições" />
                    <TextBlock Text="Executada nas duas janelas selecionadas acima." Style="{StaticResource Caption}" Margin="0,12,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="MissionTemplate">
        <Border Style="{StaticResource Card}" Width="300" Margin="0,0,12,12">
            <StackPanel>
                <CheckBox Content="{Binding Name}" IsEnabled="False" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Seleção por item ainda não disponível." Style="{StaticResource Caption}" />
                <TextBlock Text="Mapas" Margin="0,12,0,8" />
                <Border Background="#222220" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                    <TextBlock Text="Catálogo de mapas não configurado" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                </Border>
                <TextBlock Text="Launcher do MIR4" Margin="0,18,0,8" />
                <ComboBox IsEnabled="False" SelectedIndex="0">
                    <ComboBoxItem Content="Aguardando seleção por item" />
                </ComboBox>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
