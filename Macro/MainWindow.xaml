 <Window x:Class="Macro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Macro"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800"
        Background="#0B0B0B"
        FontFamily="{StaticResource PoppinsFont}">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#2D2D30">

            <StackPanel Orientation="Vertical"
                        Margin="12,20,12,0">

                <Button x:Name="BtnFarming"
                        Height="36"
                        Background="Transparent"
                        Margin="0,2,0,0"
                        BorderThickness="0"
                        Foreground="#EBEADC"
                        FontFamily="Arial"
                        FontSize="14"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="BtnFarming_Click">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Viewbox Width="18"
                                 Height="18"
                                 Margin="0,0,8,0">

                            <Canvas Width="24"
                                    Height="24">

                                <Path Data="M13 8l-9.383 9.418a2.091 2.091 0 0 0 0 2.967a2.11 2.11 0 0 0 2.976 0l9.407 -9.385"
                                      Stroke="{Binding Foreground,
                                              RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"/>

                                <Path Data="M9 3h4.586a1 1 0 0 1 .707 .293l6.414 6.414a1 1 0 0 1 .293 .707v4.586a2 2 0 1 1 -4 0v-3l-5 -5h-3a2 2 0 1 1 0 -4"
                                      Stroke="{Binding Foreground,
                                              RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>

                        <TextBlock Text="Farming"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground,
                                              RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" Background="#0B0B0B" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <Border Background="#151515" Width="400" CornerRadius="6" Padding="20" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel>
                        <TextBlock Text="Estado Atual" FontWeight="SemiBold" FontSize="14" Foreground="#EBEADC" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                            <Viewbox Width="22" Height="22" Margin="0,0,8,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"
                                          Stroke="#4c9de5"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent" />
                                    <Path Data="M7 12a5 5 0 1 0 10 0a5 5 0 1 0 -10 0"
                                          Stroke="#4c9de5"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent" />
                                    <Path Data="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"
                                          Stroke="#4c9de5"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Indo até recurso detectado" FontSize="18" VerticalAlignment="Center" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnParar" Click="BtnStop_Click" FontWeight="SemiBold" Background="#C94C4C" Foreground="White" Margin="0,0,8,0" BorderThickness="0" Width="198" Height="35">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                <Canvas Width="20" Height="24">
                                    <Path Data="M3 5a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-14"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Parar" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                        </StackPanel>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Border" Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                    </Button>
                    <Button x:Name="BtnIniciar" Click="BtnStart_Click" FontWeight="SemiBold" Content="Iniciar" Background="#4CAF50" Foreground="White" Margin="0,0,8,0" BorderThickness="0" Width="198" Height="35">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Border" Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
