<Window x:Class="Macro.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:Macro" mc:Ignorable="d" Title="Macro MIR4" Width="1440" Height="900" MinWidth="1000" MinHeight="650" Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#242322" Padding="12,20,12,16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="v1.0.0" Foreground="#A8A8A8" Margin="14,20,0,0" />
                <StackPanel Orientation="Vertical">
                    <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnFarming_Click" x:Name="BtnFarming">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M13 8l-9.383 9.418a2.091 2.091 0 0 0 0 2.967a2.11 2.11 0 0 0 2.976 0l9.407 -9.385" Stroke="{Binding Foreground,&#xD;&#xA;                               RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                                    <Path Data="M9 3h4.586a1 1 0 0 1 .707 .293l6.414 6.414a1 1 0 0 1 .293 .707v4.586a2 2 0 1 1 -4 0v-3l-5 -5h-3a2 2 0 1 1 0 -4" Stroke="{Binding Foreground,&#xD;&#xA;                               RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Farming" VerticalAlignment="Center" Foreground="{Binding Foreground,&#xD;&#xA;                               RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnTimer_Click" x:Name="BtnTimer">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                                    <Path Data="M12 12l3 2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                                    <Path Data="M12 7v5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Timer" VerticalAlignment="Center" Foreground="{Binding Foreground,&#xD;&#xA;                                              RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnDaily_Click" x:Name="BtnDaily">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12 18.5l-3 -1.5l-6 3v-13l6 -3l6 3l6 -3v7.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                                    <Path Data="M9 4v13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                                    <Path Data="M15 7v5.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                                    <Path Data="M21.121 20.121a3 3 0 1 0 -4.242 0c.418 .419 1.125 1.045 2.121 1.879c1.051 -.89 1.759 -1.516 2.121 -1.879" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                                    <Path Data="M19 18v.01" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Maps" VerticalAlignment="Center" Foreground="{Binding Foreground,&#xD;&#xA;                                              RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Navigated="MainFrame_Navigated"></Frame>
    </Grid>
</Window>