<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>Assets\app-v2.ico</ApplicationIcon>

		<!-- Publicação -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>

		<!-- Opcional: reduz um pouco o tamanho -->
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
	</PropertyGroup>

	<!-- Pastas -->
	<ItemGroup>
		<Folder Include="Assets\Fonts\" />
		<Folder Include="Controls\" />
	</ItemGroup>

	<!-- Recursos -->
	<ItemGroup>
		<!-- Imagem usada pelo WPF -->
		<Resource Include="Assets\teste.png" />
		<Resource Include="Assets\raid-slide-1.png" />
		<Resource Include="Assets\raid-slide-2.png" />
		<Resource Include="Assets\boss-slide-1.png" />
		<Resource Include="Assets\boss-slide-2.png" />
		<Content Include="Assets\app-icon.png" />
		<Content Include="Assets\app.ico" />
		<Resource Include="Assets\app-v2.ico" />
		<Content Include="Assets\RaidDetection\*.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Include="Assets\EnergySave\*.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>

		<!-- JSON embutido no executável -->
		<!-- JSON copiado para saída para permitir execução fora da pasta de publicação -->
		<Content Include="Data\bosses.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="Emgu.CV" Version="4.13.0.5924" />
	  <PackageReference Include="Emgu.CV.runtime.windows" Version="4.13.0.5924" />
	</ItemGroup>

</Project>
