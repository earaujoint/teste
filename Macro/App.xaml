<Application x:Class="Macro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Macro"
             StartupUri="MainWindow.xaml">

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="PoppinsFont">/Macro;component/Assets/Fonts/#Poppins</FontFamily>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily"
                        Value="{StaticResource PoppinsFont}" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="FontFamily"
                        Value="{StaticResource PoppinsFont}" />
            </Style>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/SidebarButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>