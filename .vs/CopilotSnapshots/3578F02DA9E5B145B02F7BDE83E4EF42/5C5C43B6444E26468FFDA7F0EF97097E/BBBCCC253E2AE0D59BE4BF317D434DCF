<Application x:Class="Macro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Macro"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <FontFamily x:Key="PoppinsFont">/Macro;component/Assets/Fonts/#Poppins</FontFamily>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PoppinsFont}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource PoppinsFont}" />
        </Style>
        <!-- Estilo específico para botões da sidebar -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#ebeadc" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <!-- fundo levemente mais claro -->
                    <Setter Property="Background" Value="#3B3B3F" />
                    <!-- ícone e texto ficam vermelho não tão claro -->
                    <Setter Property="Foreground" Value="#C94C4C" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>
