 <Window x:Class="Macro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Macro"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800"
        Background="#0B0B0B"
        FontFamily="{StaticResource PoppinsFont}">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#2D2D30">

            <StackPanel Orientation="Vertical"
                        Margin="12,20,12,0">

                <Button x:Name="BtnFarming"
                        Height="36"
                        Background="Transparent"
                        Margin="0,10,0,0"
                        BorderThickness="0"
                        Foreground="#EBEADC"
                        FontFamily="Arial"
                        FontSize="14"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="BtnFarming_Click">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Viewbox Width="18"
                                 Height="18"
                                 Margin="0,0,8,0">

                            <Canvas Width="24"
                                    Height="24">

                                <Path Data="M13 8l-9.383 9.418a2.091 2.091 0 0 0 0 2.967a2.11 2.11 0 0 0 2.976 0l9.407 -9.385"
                                      Stroke="{Binding Foreground,
                                              RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"/>

                                <Path Data="M9 3h4.586a1 1 0 0 1 .707 .293l6.414 6.414a1 1 0 0 1 .293 .707v4.586a2 2 0 1 1 -4 0v-3l-5 -5h-3a2 2 0 1 1 0 -4"
                                      Stroke="{Binding Foreground,
                                              RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>

                        <TextBlock Text="Farming"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground,
                                              RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1"
              Background="#0B0B0B">

            <Border Background="#151515"
                    CornerRadius="6"
                    Padding="18"
                    Margin="20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">

                <StackPanel>
                    <TextBlock Text="Estado Atual"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="#EBEADC"/>

                    <TextBlock Text="Indo até recurso detectado"
                               Margin="0,8,0,0"
                               Foreground="#FFFFFF"
                               FontWeight="Bold"
                               FontSize="16"
                               />
                </StackPanel>
            </Border>
            
            <StackPanel Orientation="Horizontal"
                 Margin="0,16,0,0">

                <Button x:Name="BtnParar"
                 Content="Parar"
                 Background="#C94C4C"
                 Foreground="White"
                 Padding="12,6"
                 Margin="0,0,8,0"
                 BorderThickness="0"
                 Width="100"
                 Height="30"/>

                <Button x:Name="BtnIniciar"
                 Content="Iniciar"
                 Background="#4CAF50"
                 Foreground="White"
                 Padding="12,6"
                 BorderThickness="0"
                 Width="100"
                 Height="30"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
