 <Window x:Class="Macro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Macro"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800"
        Background="#0B0B0B"
        FontFamily="{StaticResource PoppinsFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2D2D30">
            <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnFarming_Click">
                    <StackPanel Orientation="Horizontal"
                 VerticalAlignment="Center">
                        <Viewbox Width="18"
                  Height="18"
                  Margin="0,0,8,0">
                            <Canvas Width="24"
                     Height="24">
                                <Path Data="M13 8l-9.383 9.418a2.091 2.091 0 0 0 0 2.967a2.11 2.11 0 0 0 2.976 0l9.407 -9.385"
                       Stroke="{Binding Foreground,
                               RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                       StrokeThickness="2"
                       StrokeStartLineCap="Round"
                       StrokeEndLineCap="Round"
                       StrokeLineJoin="Round"
                       Fill="Transparent"/>
                                <Path Data="M9 3h4.586a1 1 0 0 1 .707 .293l6.414 6.414a1 1 0 0 1 .293 .707v4.586a2 2 0 1 1 -4 0v-3l-5 -5h-3a2 2 0 1 1 0 -4"
                       Stroke="{Binding Foreground,
                               RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                       StrokeThickness="2"
                       StrokeStartLineCap="Round"
                       StrokeEndLineCap="Round"
                       StrokeLineJoin="Round"
                       Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Farming"
                    VerticalAlignment="Center"
                    Foreground="{Binding Foreground,
                               RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnDaily_Click">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Viewbox Width="18"
                                 Height="18"
                                 Margin="0,0,8,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M7 9.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667l0 -8.666"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent" />
                                <Path Data="M4.012 16.737a2 2 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent" />
                                <Path Data="M11 14l2 2l4 -4"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Maps"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground,
                                              RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            
        </Border>

        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"></Frame>
  
    </Grid>

</Window>
