<Window x:Class="Macro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Macro"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" FontFamily="{StaticResource PoppinsFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56*"/>
            <RowDefinition Height="379*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="11.9"/>
            <ColumnDefinition Width="11.265"/>
            <ColumnDefinition Width="1.111"/>
            <ColumnDefinition Width="63.3"/>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar esquerdo -->
        <StackPanel Grid.Column="0" Background="#FF2D2D30" Orientation="Vertical" Margin="0,-18,0,0" Grid.RowSpan="2" Grid.ColumnSpan="5" HorizontalAlignment="Stretch">
            <Button x:Name="BtnFarming" Height="36" Background="Transparent" Margin="12,30,8,0" BorderThickness="0" Foreground="#ebeadc" FontFamily="Arial" Click="BtnFarming_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="14" FontWeight="SemiBold">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="18" Height="18" Margin="0,0,5,0">
                        <Canvas Width="24" Height="24">
                            <Path Data="M13 8l-9.383 9.418a2.091 2.091 0 0 0 0 2.967a2.11 2.11 0 0 0 2.976 0l9.407 -9.385"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"/>
                            <Path Data="M9 3h4.586a1 1 0 0 1 .707 .293l6.414 6.414a1 1 0 0 1 .293 .707v4.586a2 2 0 1 1 -4 0v-3l-5 -5h-3a2 2 0 1 1 0 -4"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Farming" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel Background="#151515" CornerRadius="6" Padding="18" Margin="20" HorizontalAlignment="Left" VerticalAlignment="Top">

            <TextBlock Grid.Row="0" Text="Estado Atual" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF" />
                <TextBlock Grid.Row="1" Text="Indo até recurso detectado" Margin="0,8,0,0" Foreground="#D0D0D0" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="BtnParar" Content="Parar" Background="#C94C4C" Foreground="White" Padding="12,6" Margin="0,0,8,0" BorderThickness="0" Width="100" />
                    <Button x:Name="BtnIniciar" Content="Iniciar" Background="#4CAF50" Foreground="White" Padding="12,6" BorderThickness="0" Width="100" />
                </StackPanel>
        </StackPanel>
    </Grid>
</Window>
