<UserControl x:Class="Macro.Controls.StateCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="400">
    <Border Background="#151515" CornerRadius="6" Padding="18">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14" Foreground="#EBEADC" />
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                <Viewbox Width="22" Height="22" Margin="0,0,8,0">
                    <Canvas Width="24" Height="24">
                        <Path Data="M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" Stroke="#4c9de5" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                        <Path Data="M7 12a5 5 0 1 0 10 0a5 5 0 1 0 -10 0" Stroke="#4c9de5" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                        <Path Data="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" Stroke="#4c9de5" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Canvas>
                </Viewbox>
                <TextBlock x:Name="DescriptionText" FontSize="18" VerticalAlignment="Center" Foreground="#FFFFFF" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
